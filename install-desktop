#!/usr/bin/env python3
"""Register this checkout in the current user's Linux application menu."""

import os
import shutil
import sys
from pathlib import Path

root = Path(__file__).resolve().parent
appimage = (
    Path(sys.argv[1]).expanduser().resolve()
    if len(sys.argv) > 1
    else root / "dist" / "Tingsu-Linux-x86_64.AppImage"
)
if not appimage.is_file() or not os.access(appimage, os.X_OK):
    raise SystemExit(f"请先准备可执行的 AppImage：{appimage}")
local_data = Path(os.getenv("XDG_DATA_HOME") or Path.home() / ".local/share")
icon = local_data / "icons/hicolor/scalable/apps/tingsu.svg"
icon.parent.mkdir(parents=True, exist_ok=True)
shutil.copyfile(root / "meeting_agent/ui/tingsu.svg", icon)
applications = local_data / "applications"
applications.mkdir(parents=True, exist_ok=True)
desktop = applications / "tingsu.desktop"


def argument(value):
    text = str(value).replace("%", "%%")
    for character in ("\\", '"', "`", "$"):
        text = text.replace(character, "\\" + character)
    return '"' + text.replace("\\", "\\\\") + '"'


content = f"""[Desktop Entry]
Type=Application
Name=听序
Name[en]=Tingsu
GenericName=AI 会议工作台
Comment=实时会议转写、AI 对话与便签
Exec={argument(appimage)}
Icon=tingsu
Terminal=false
Categories=AudioVideo;Audio;Qt;
Keywords=meeting;transcription;会议;转写;Codex;
X-Tingsu-Launcher=true
"""
if desktop.exists() and "X-Tingsu-Launcher=true" not in desktop.read_text():
    raise SystemExit(f"路径已被其他启动器占用：{desktop}")
desktop.write_text(content, encoding="utf-8")
print(f"已注册桌面应用：{desktop}")
