#!/bin/sh
# Resolve all runtime paths from this read-only AppDir. User data stays in XDG directories.
set -eu
base=${APPDIR:-$(dirname "$(readlink -f "$0")")}
if [ -n "${APPIMAGE:-}" ]; then
    export TINGSU_APP_DIR="$(dirname "$APPIMAGE")"
else
    export TINGSU_APP_DIR="$base"
fi
# Host agents use their own tools and loader paths.
export TINGSU_HOST_VARIABLES="PATH PYTHONHOME PYTHONPATH PYTHONNOUSERSITE PYTHONDONTWRITEBYTECODE LD_LIBRARY_PATH LIBGL_DRIVERS_PATH LIBGL_ALWAYS_SOFTWARE __EGL_VENDOR_LIBRARY_FILENAMES __GLX_VENDOR_LIBRARY_NAME ALSA_CONFIG_DIR QT_PLUGIN_PATH QTWEBENGINEPROCESS_PATH QTWEBENGINE_RESOURCES_PATH QTWEBENGINE_LOCALES_PATH GI_TYPELIB_PATH GST_PLUGIN_SYSTEM_PATH_1_0 GST_PLUGIN_PATH_1_0 GST_PLUGIN_SCANNER_1_0 PIPEWIRE_MODULE_DIR SPA_PLUGIN_DIR PIPEWIRE_CONFIG_DIR PULSE_CONFIG_PATH FONTCONFIG_FILE XDG_DATA_DIRS QT_QPA_PLATFORM"
for name in $TINGSU_HOST_VARIABLES; do
    if original=$(printenv "$name"); then
        export "TINGSU_HOST_$name=$original"
    else
        unset "TINGSU_HOST_$name"
    fi
done
export TINGSU_APPIMAGE_RUNTIME=1
prefix="$base/usr"
export TINGSU_BUNDLE="$prefix/share/tingsu"
export LD_LIBRARY_PATH="$prefix/lib/tingsu/native${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
if [ -x /sbin/ldconfig ]; then ldcache=$(/sbin/ldconfig -p 2>/dev/null || :); else ldcache=""; fi
for directory in "$prefix"/lib/tingsu/graphics-fallback/*; do
    [ -d "$directory" ] || continue
    case "$ldcache" in *"${directory##*/} (libc6,x86-64)"*) ;; *) LD_LIBRARY_PATH="$LD_LIBRARY_PATH:$directory";; esac
done
export TINGSU_DESKTOP_HOST="$prefix/bin/tingsu-webview"
for arg in "$@"; do
    case "$arg" in --wayland) export GDK_BACKEND=wayland;; --x11) export GDK_BACKEND=x11;; esac
done
export ALSA_CONFIG_DIR="$prefix/share/alsa"
export PATH="$prefix/bin:$PATH"
export GST_PLUGIN_SYSTEM_PATH_1_0="$prefix/lib/tingsu/gstreamer" GST_PLUGIN_PATH_1_0=""
export GST_PLUGIN_SCANNER_1_0="$prefix/lib/tingsu/gst-plugin-scanner"
export PIPEWIRE_MODULE_DIR="$prefix/lib/tingsu/pipewire" SPA_PLUGIN_DIR="$prefix/lib/tingsu/spa"
export PIPEWIRE_CONFIG_DIR="$prefix/share/pipewire"
export PULSE_CONFIG_PATH="$prefix/share/tingsu/pulse"
# Keep user and system directories available to XDG portals and desktop themes.
export XDG_DATA_DIRS="$prefix/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
exec "$prefix/bin/tingsu" "$@"
