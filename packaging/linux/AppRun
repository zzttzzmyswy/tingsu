#!/bin/sh
# Resolve all runtime paths from this read-only AppDir. User data stays in XDG directories.
set -eu
base=${APPDIR:-$(dirname "$(readlink -f "$0")")}
if [ -n "${APPIMAGE:-}" ]; then
    export TINGSU_APP_DIR="$(dirname "$APPIMAGE")"
else
    export TINGSU_APP_DIR="$base"
fi
# Host agents (Claude Code and dsh) use their own tools and loader paths.
export TINGSU_HOST_VARIABLES="PATH PYTHONHOME PYTHONPATH PYTHONNOUSERSITE PYTHONDONTWRITEBYTECODE LD_LIBRARY_PATH LIBGL_DRIVERS_PATH LIBGL_ALWAYS_SOFTWARE __EGL_VENDOR_LIBRARY_FILENAMES __GLX_VENDOR_LIBRARY_NAME ALSA_CONFIG_DIR QT_PLUGIN_PATH QTWEBENGINEPROCESS_PATH QTWEBENGINE_RESOURCES_PATH QTWEBENGINE_LOCALES_PATH GI_TYPELIB_PATH GST_PLUGIN_SYSTEM_PATH_1_0 GST_PLUGIN_PATH_1_0 GST_PLUGIN_SCANNER_1_0 PIPEWIRE_MODULE_DIR SPA_PLUGIN_DIR PIPEWIRE_CONFIG_DIR PULSE_CONFIG_PATH FONTCONFIG_FILE XDG_DATA_DIRS QT_QPA_PLATFORM"
for name in $TINGSU_HOST_VARIABLES; do
    if original=$(printenv "$name"); then
        export "TINGSU_HOST_$name=$original"
    else
        unset "TINGSU_HOST_$name"
    fi
done
export TINGSU_APPIMAGE_RUNTIME=1
prefix="$base/usr"
qt="$prefix/lib/tingsu/python/PySide6/Qt"
export PYTHONHOME="$prefix" PYTHONNOUSERSITE=1 PYTHONDONTWRITEBYTECODE=1
export PYTHONPATH="$prefix/lib/tingsu/python:$prefix/lib/python3/dist-packages"
export LD_LIBRARY_PATH="$prefix/lib/tingsu/native:$qt/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
# A Mesa driver and its GBM/GL loader must agree on their internal interface.
# Minimal desktops can use the packaged fallback for each absent client library.
ldcache=""
if [ -x /sbin/ldconfig ]; then
    ldcache=$(/sbin/ldconfig -p 2>/dev/null || :)
fi
for directory in "$prefix"/lib/tingsu/graphics-fallback/*; do
    [ -d "$directory" ] || continue
    case "$ldcache" in
        *"${directory##*/} (libc6,x86-64)"*) ;;
        *) LD_LIBRARY_PATH="$LD_LIBRARY_PATH:$directory" ;;
    esac
done
# Headless X11 servers and minimal VMs do not always have a vendor OpenGL implementation.
if ! printf '%s\n' "$ldcache" | grep -Eq 'lib(GLX|EGL)_[[:alnum:]_-]+\.so[[:digit:].]* \(libc6,x86-64'; then
    software_gl="$prefix/lib/tingsu/graphics-software"
    export LD_LIBRARY_PATH="$LD_LIBRARY_PATH:$software_gl/lib"
    export LIBGL_DRIVERS_PATH="$software_gl/drivers" LIBGL_ALWAYS_SOFTWARE=1
    export __EGL_VENDOR_LIBRARY_FILENAMES="$software_gl/50_mesa.json" __GLX_VENDOR_LIBRARY_NAME=mesa
fi
export ALSA_CONFIG_DIR="$prefix/share/alsa"
export PATH="$prefix/bin:$prefix/lib/tingsu/codex/bin:$PATH"
export QT_PLUGIN_PATH="$qt/plugins" QTWEBENGINEPROCESS_PATH="$qt/libexec/QtWebEngineProcess"
export QTWEBENGINE_RESOURCES_PATH="$qt/resources" QTWEBENGINE_LOCALES_PATH="$qt/translations/qtwebengine_locales"
export GI_TYPELIB_PATH="$prefix/lib/tingsu/typelib"
export GST_PLUGIN_SYSTEM_PATH_1_0="$prefix/lib/tingsu/gstreamer" GST_PLUGIN_PATH_1_0=""
export GST_PLUGIN_SCANNER_1_0="$prefix/lib/tingsu/gst-plugin-scanner"
export PIPEWIRE_MODULE_DIR="$prefix/lib/tingsu/pipewire" SPA_PLUGIN_DIR="$prefix/lib/tingsu/spa"
export PIPEWIRE_CONFIG_DIR="$prefix/share/pipewire"
export PULSE_CONFIG_PATH="$prefix/share/tingsu/pulse"
export FONTCONFIG_FILE="$prefix/share/tingsu/fonts.conf"
# Keep user and system directories available to XDG portals and desktop themes.
export XDG_DATA_DIRS="$prefix/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
exec "$prefix/bin/python3.10" -sB "$prefix/lib/tingsu/start.py" "$@"
