#!/bin/sh
set -eu
project=$(dirname "$(readlink -f "$0")")
cd "$project"
mkdir -p build
export PATH="$project/build:$PATH"
if [ ! -x build/tingsu-portal ] || [ desktop/portal/main.c -nt build/tingsu-portal ]; then
    desktop/portal/build.sh build/tingsu-portal
fi
go build -tags novulkan -trimpath -o build/tingsu ./cmd/tingsu
exec build/tingsu "$@"
